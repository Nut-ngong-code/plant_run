# ตัวอย่าง .env สำหรับรันบน Raspberry Pi + Tailscale Funnel
#
# วิธีใช้บน Pi:
#   cp .env.pi.example .env
#   nano .env          # แล้วแทนที่ 3 จุด: <TS_URL>, STRAVA_CLIENT_ID, STRAVA_CLIENT_SECRET
#
# หา <TS_URL> ได้จาก `tailscale status` หรือ `tailscale funnel status`
# หน้าตาประมาณ https://plantpi.tail1234.ts.net  (ไม่ต้องใส่ / ปิดท้าย)

# Database — MySQL รันใน Docker บน Pi เครื่องเดียวกัน
DATABASE_URL="mysql://plant_dev:devpassword123@localhost:3306/plant_run_db"

# Server
PORT=3000

# URL สาธารณะของ Funnel — ใช้ตอน redirect กลับหลัง Strava OAuth
# ต้องเป็น URL เต็มพร้อม https:// เพราะ Strava จะเด้งผู้ใช้กลับมาที่นี่
FRONTEND_URL=https://<TS_URL>

# Strava OAuth — คัดลอกค่าจาก .env เดิมบนโน้ตบุ๊ก
STRAVA_CLIENT_ID=229713
STRAVA_CLIENT_SECRET=<ค่าเดิมจากโน้ตบุ๊ก>

# ⚠️ ต้องตรงกับที่ตั้งใน https://www.strava.com/settings/api
#    ช่อง "Authorization Callback Domain" ใส่แค่โดเมนเปล่า ไม่มี https:// และไม่มี path
#    เช่น  plantpi.tail1234.ts.net
STRAVA_REDIRECT_URI=https://<TS_URL>/api/auth/strava/callback

# Points rules (ตามเอกสารขอบเขตงาน)
POINTS_PER_KM=10
POINTS_COST_WATER=15
POINTS_COST_FERTILIZER=20
