// Prisma schema for Plant Watering / Run-for-Plant project.
// Source of truth: database/init.sql (MySQL).
// Model / field names are camelCase in JavaScript; @@map / @map keep
// compatibility with the existing UPPERCASE table names.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int          @id @default(autoincrement())
  stravaId       String       @unique(map: "strava_id") @map("strava_id") @db.VarChar(100)
  displayName    String?      @map("display_name") @db.VarChar(150)
  accessToken    String?      @map("access_token") @db.Text
  refreshToken   String?      @map("refresh_token") @db.Text
  tokenExpiresAt DateTime?    @map("token_expires_at") @db.DateTime(0)
  totalPoints    Int?         @default(0) @map("total_points")
  createdAt      DateTime?    @default(now()) @map("created_at") @db.Timestamp(0)
  devices        Device[]
  runs           RunHistory[]
  actions        ActionLog[]

  @@map("USER")
}

model Device {
  id            Int            @id @default(autoincrement())
  userId        Int            @map("user_id")
  deviceId      String         @unique(map: "device_id") @map("device_id") @db.VarChar(100)
  authTokenHash String?        @map("auth_token_hash") @db.VarChar(64)
  displayName   String?        @map("display_name") @db.VarChar(150)
  isOnline     Boolean?       @default(false) @map("is_online")
  lastSeenAt   DateTime?      @map("last_seen_at") @db.DateTime(0)
  createdAt    DateTime?      @default(now()) @map("created_at") @db.Timestamp(0)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "DEVICE_ibfk_1")
  soilLogs     SoilLog[]
  actions      ActionLog[]
  schedules    AutoSchedule[]

  @@index([userId], map: "user_id")
  @@map("DEVICE")
}

model RunHistory {
  id               Int       @id @default(autoincrement())
  userId           Int       @map("user_id")
  stravaActivityId String    @unique(map: "strava_activity_id") @map("strava_activity_id") @db.VarChar(100)
  distanceKm       Float?    @map("distance_km") @db.Float
  pointsEarned     Int?      @map("points_earned")
  runAt            DateTime? @map("run_at") @db.DateTime(0)
  syncedAt         DateTime? @default(now()) @map("synced_at") @db.Timestamp(0)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "RUN_HISTORY_ibfk_1")

  @@index([userId], map: "user_id")
  @@map("RUN_HISTORY")
}

model ActionLog {
  id              Int       @id @default(autoincrement())
  userId          Int       @map("user_id")
  deviceId        Int       @map("device_id")
  actionType      String?   @map("action_type") @db.VarChar(50)
  status          String?   @db.VarChar(50)
  pointsDeducted  Int?      @map("points_deducted")
  durationSeconds Int?      @map("duration_seconds")
  scheduledAt     DateTime? @map("scheduled_at") @db.DateTime(0)
  executedAt      DateTime? @map("executed_at") @db.DateTime(0)
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "ACTION_LOG_ibfk_1")
  device          Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "ACTION_LOG_ibfk_2")

  @@index([deviceId], map: "device_id")
  @@index([userId], map: "user_id")
  @@map("ACTION_LOG")
}

model SoilLog {
  id              Int       @id @default(autoincrement())
  deviceId        Int       @map("device_id")
  moisturePercent Int?      @map("moisture_percent")
  recordedAt      DateTime? @default(now()) @map("recorded_at") @db.Timestamp(0)
  device          Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "SOIL_LOG_ibfk_1")

  @@index([deviceId], map: "device_id")
  @@map("SOIL_LOG")
}

model AutoSchedule {
  id              Int       @id @default(autoincrement())
  deviceId        Int       @map("device_id")
  actionType      String?   @map("action_type") @db.VarChar(50)
  cronExpression  String?   @map("cron_expression") @db.VarChar(100)
  durationSeconds Int?      @map("duration_seconds")
  isActive        Boolean?  @default(true) @map("is_active")
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  device          Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "AUTO_SCHEDULE_ibfk_1")

  @@index([deviceId], map: "device_id")
  @@map("AUTO_SCHEDULE")
}
