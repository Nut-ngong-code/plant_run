# systemd unit — ให้ backend ขึ้นเองตอน Pi บูต ไม่ต้อง ssh เข้าไปสั่ง
#
# ติดตั้ง (รันบน Pi ครั้งเดียว):
#   sudo cp ~/final-project/scripts/plant-backend.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now plant-backend
#
# ดูสถานะ / log:
#   systemctl status plant-backend
#   journalctl -u plant-backend -f
#
# ⚠️⚠️ อ่านก่อน copy ทับ — เคยทำระบบล่มมาแล้ว 2026-09-04
# User= กับ WorkingDirectory= ข้างล่างตั้งไว้ตามเครื่องจริง (user `respi`, clone ที่ ~/final-project)
# ถ้าเครื่องปลายทางใช้ user อื่น หรือ clone ไว้ path อื่น ต้องแก้ 2 บรรทัดนั้นก่อนเสมอ
# อาการเมื่อตั้งผิด: service วน restart ทุก 10 วิ ด้วย `status=217/USER`
#   (journalctl: "Failed to determine user credentials: No such process")
# เช็คให้ตรงด้วย:
#   whoami                      # ต้องตรงกับ User=
#   ls -d ~/final-project/backend   # ต้องตรงกับ WorkingDirectory=
#
# หมายเหตุ path: `code/` เป็น root ของ git repo — clone เป็น final-project แล้วเนื้อหาอยู่ที่
# ~/final-project/backend ไม่มีชั้น `code/` คั่น

[Unit]
Description=Plant Watering backend (Express + Prisma)
# รอ network ก่อน ไม่งั้น Prisma ต่อ MySQL ไม่ติดตอนบูต
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=respi
WorkingDirectory=/home/respi/final-project/backend
ExecStart=/usr/bin/node src/index.js
Environment=NODE_ENV=production

# MySQL ใน Docker ใช้เวลาบูตนานบน Pi 3 + SD card ถ้า backend ขึ้นก่อนจะตายแล้ว restart วนจนกว่า DB พร้อม
Restart=always
RestartSec=10

# ให้ log ไปที่ journalctl
StandardOutput=journal
StandardError=journal
SyslogIdentifier=plant-backend

[Install]
WantedBy=multi-user.target
